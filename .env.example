# ==============================================================================
# Planly App - Enterprise Environment Configuration Template
# ==============================================================================
# Supply via --dart-define during build/run or load into .env

# Google Gemini AI Model Provider Key (for AI Task Deconstruction)
GEMINI_API_KEY=your_gemini_api_key_placeholder

# Optional Google AdMob Production Unit IDs
ADMOB_ANDROID_BANNER_ID=ca-app-pub-placeholder
ADMOB_IOS_BANNER_ID=ca-app-pub-placeholder
ADMOB_ANDROID_INTERSTITIAL_ID=ca-app-pub-placeholder
ADMOB_IOS_INTERSTITIAL_ID=ca-app-pub-placeholder

PORT=8080
